name: code stats
on:
  push:
    branches: [main]
permissions:
  contents: write
jobs:
  stats:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: python3 tools/loc.py
      - run: |
          if git diff --quiet -- stats.json; then exit 0; fi
          git config user.name "stats-bot"; git config user.email "stats-bot@users.noreply.github.com"
          git add stats.json; git commit -m "stats.json: regenerate line count [skip ci]"; git push
