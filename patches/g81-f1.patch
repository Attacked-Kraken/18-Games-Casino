+/* G-81: REALITY robot hook (REALITY.md "Robot hook") - the robot measures size, racing direction and
+   ground contact in the running game. Getters keep it pointed at the live weekend's cars. */
+const _realityAnchors=[new THREE.Object3D(), new THREE.Object3D(), new THREE.Object3D(), new THREE.Object3D()];
+const _realityV=new THREE.Vector3();
+function _realitySD(x, z){ // nearest track point -> arclength s + lateral d of a world point
+  const sm=Track.samples; let bi=0, bd=1e18;
+  for(let i=0;i<sm.length;i++){ const dx=sm[i].x-x, dz=sm[i].z-z, q=dx*dx+dz*dz; if(q<bd){ bd=q; bi=i; } }
+  const p=sm[bi], dx=x-p.x, dz=z-p.z;
+  return { s: p.s+dx*p.tx+dz*p.tz, d: dx*p.nx+dz*p.nz };
+}
+window.__reality={
+  kind: 'f1',
+  get player(){ return (Race.player && Race.player.mesh) || null; },
+  get others(){ return Race.cars ? Race.cars.filter(c=>!c.isPlayer && c.mesh).map(c=>c.mesh) : []; },
+  get contact(){ return Race.player ? _realityAnchors : []; },
+  ground: (x, z)=>{ if(!Track.samples || !Track.samples.length) return 0; const sd=_realitySD(x, z); return Track.posAt(sd.s, sd.d, 0).y; },
+  track: (x, z)=>{ if(!Track.samples || !Track.samples.length) return { x:0, z:1 }; const sd=_realitySD(x, z); const f=Track.frameAt(sd.s); return { x:f.tx, z:f.tz }; },
