+/* ================= G-48: the owner's cockpit kit (kit/cockpit) =================
+   Parsed at boot like the track. Rides inside the player's car (hidden unless
+   the COCKPIT camera is on): real halo, dash and wheel - the wheel turns with
+   the player's steering and the 15 shift LEDs climb with the revs. */
+const CK = { root:null, wheel:null, leds:null, _boot:null, attachedTo:null };
+function CKBoot(){
+  if(CK._boot) return CK._boot;
+  CK._boot = (async()=>{
+    try{
+      const buf = await fetch('kit/cockpit/cockpit.glb').then(r=>r.arrayBuffer());
+      const { GLTFLoader } = await import('./vendor/GLTFLoader.js');
+      const gltf = await new GLTFLoader().parseAsync(buf, '');
+      CK.root = gltf.scene;
+      CK.root.rotation.y = Math.PI/2; // the kit faces +Z; our car model faces +X
+      CK.root.position.set(0.17, 0, 0); // driver eye lands on our car's driving spot
+      CK.root.visible = false;
+      CK.root.traverse(o=>{ if(o.isMesh) o.castShadow = false; });
+      CK.wheel = CK.root.getObjectByName('SteeringWheel');
+      CK.leds = [];
+      for(let i=0;i<15;i++){ const l=CK.root.getObjectByName('LED_'+i); if(l) CK.leds.push(l); }
+    }catch(e){ /* no cockpit kit: the COCKPIT cam choice falls back to chase */ }
+    return CK;
+  })();
+  return CK._boot;
+}
+function CKAttach(){
+  if(CK.root && Race.player && CK.attachedTo!==Race.player){
+    Race.player.mesh.add(CK.root); CK.attachedTo = Race.player;
+  }
+}
+CKBoot();
