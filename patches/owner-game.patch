+function growTyres(tilt, model, tireMat, hubs, rimScale) {
+  tilt.updateWorldMatrix(true, true);
+  const invT = new THREE.Matrix4().copy(tilt.matrixWorld).invert(), v = new THREE.Vector3();
+  model.traverse((q) => {
+    if (!q.isMesh || q.material !== tireMat || !q.geometry || !q.geometry.attributes.position) return;
+    q.geometry = q.geometry.clone();
+    const A = new THREE.Matrix4().multiplyMatrices(invT, q.matrixWorld);
+    const B = new THREE.Matrix4().multiplyMatrices(new THREE.Matrix4().copy(q.matrixWorld).invert(), tilt.matrixWorld);
+    const pa = q.geometry.attributes.position;
+    for (let i = 0; i < pa.count; i++) {
