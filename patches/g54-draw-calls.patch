+/* ================= G-54: draw-call diet (identical picture, far fewer meshes) =================
+   A built car was ~84 meshes; 20 cars were ~1,680 of the ~1,800 draw calls.
+   Body parts never move relative to the car, so per car they merge into one
+   mesh per material (same geometries, same materials, same transforms).
+   Wheel parts must keep spinning/steering with their wheel groups, so the
+   originals stay in the graph (hidden) and four InstancedMeshes draw every
+   wheel of every car, copying each part's world matrix every frame. */
+const WHEEL_INST = { parts:{tire:[],stripe:[],cover:[],cap:[]}, extra:{tire:[],stripe:[],cover:[],cap:[]}, meshes:{}, tireR:0 };
+const _wm4 = new THREE.Matrix4();
+function wheelInstMesh(type, part){
+  let im = WHEEL_INST.meshes[type];
+  if(!im){
+    const mat = part.material.clone();
+    if(type!=='tire') mat.color.setRGB(1,1,1); // the tint comes from the per-instance colour
+    im = new THREE.InstancedMesh(part.geometry, mat, (type==='stripe'||type==='cap')?192:96);
+    im.frustumCulled=false; im.castShadow=false; im.count=0;
+    im.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
+    scene.add(im); WHEEL_INST.meshes[type]=im;
+  }
+  return im;
+}
+function wheelInstRegister(g){
+  for(const w of g.userData.wheels||[]){
+    for(const part of w.children){
+      const type = part.userData.instType; if(!type) continue;
+      const list = WHEEL_INST.parts[type];
+      if(list.length >= ((type==='stripe'||type==='cap')?192:96)) continue; // overflow: leave the part visible as-is
+      const im = wheelInstMesh(type, part);
+      const slot = list.length; list.push(part);
+      if(type==='tire'){
+        const r = part.geometry.parameters.radiusTop;
+        if(!WHEEL_INST.tireR) WHEEL_INST.tireR = r;
+        WHEEL_INST.extra.tire[slot] = (r!==WHEEL_INST.tireR) ? new THREE.Matrix4().makeScale(r/WHEEL_INST.tireR, 1, r/WHEEL_INST.tireR) : null; // (cylinder radius is local X/Z; the axle Y keeps its width)
+      }
+      if(type!=='tire') im.setColorAt(slot, part.material.color);
+      part.visible = false;
+    }
+  }
+  for(const t in WHEEL_INST.meshes){ const im=WHEEL_INST.meshes[t]; if(im.instanceColor) im.instanceColor.needsUpdate=true; }
+}
+function wheelInstReset(){
+  WHEEL_INST.parts={tire:[],stripe:[],cover:[],cap:[]};
+  WHEEL_INST.extra={tire:[],stripe:[],cover:[],cap:[]};
+}
+function wheelInstUpdate(){
+  if(!WHEEL_INST.meshes.tire) return;
+  scene.updateMatrixWorld();
+  for(const type in WHEEL_INST.meshes){
+    const im = WHEEL_INST.meshes[type], list = WHEEL_INST.parts[type];
+    im.count = list.length;
+    for(let i=0;i<list.length;i++){
+      const ex = WHEEL_INST.extra[type][i];
+      if(ex){ _wm4.multiplyMatrices(list[i].matrixWorld, ex); im.setMatrixAt(i, _wm4); }
+      else im.setMatrixAt(i, list[i].matrixWorld);
+    }
+    im.instanceMatrix.needsUpdate = true;
+  }
+}
+function mergeCarBody(g){
+  const skip = new Set();
+  const skipTree = (o)=>{ if(o) o.traverse(x=>skip.add(x)); };
+  for(const w of g.userData.wheels||[]) skipTree(w);
+  skipTree(g.userData.drsFlap); skipTree(g.userData.rainLight);
+  g.updateMatrixWorld(true);
+  const parts = [];
+  g.traverse(o=>{ if(o.isMesh && !skip.has(o)) parts.push(o); });
+  const buckets = new Map();
+  for(const m of parts){
+    const geo = m.geometry.index ? m.geometry.toNonIndexed() : m.geometry.clone();
+    geo.applyMatrix4(m.matrixWorld); // g sits at the origin while building: world == car-local
+    if(!buckets.has(m.material)) buckets.set(m.material, { geos:[], shadow:false, parts:[] });
+    const b = buckets.get(m.material);
+    b.geos.push(geo); b.parts.push(m); b.shadow = b.shadow || !!m.castShadow;
+  }
+  for(const [mat, b] of buckets){
+    const mergedGeo = mergeGeometries(b.geos, false);
+    if(!mergedGeo) continue; // could not merge this bucket: leave its parts as they were
+    for(const m of b.parts) m.parent.remove(m);
+    const merged = new THREE.Mesh(mergedGeo, mat);
+    merged.castShadow = b.shadow;
+    g.add(merged);
+  }
+}
