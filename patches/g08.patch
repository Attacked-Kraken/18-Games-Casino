+/* ================= FRIEND CODES (G-08) =================
+   The site is static (no server), so friend matches are asynchronous: a code
+   carries a friend's name + strength + record, and you play THEIR team (Sharks)
+   with the CPU driving it at their strength. Same pattern as apexhockey. */
+let friendGame = null;                    // {name, str} while a friend match is set
+const FKEY = 'apex_baseball_friends_v1';
+function fLoad(){ try{ const r = JSON.parse(localStorage.getItem(FKEY)); return r && typeof r==='object' ? r : { w:0, l:0, name:'' }; }catch(e){ return { w:0, l:0, name:'' }; } }
+function fSave(r){ try{ localStorage.setItem(FKEY, JSON.stringify(r)); }catch(e){} }
+function myFriendStr(){ const r = fLoad(); return Math.max(35, Math.min(95, 50 + (r.w|0)*3 - (r.l|0)*2)); }
+function myFriendCode(){
+  const r = fLoad();
+  const p = { v:1, n:String(r.name || 'COMETS FAN').slice(0,16), str:myFriendStr(), w:r.w|0, l:r.l|0 };
+  return 'BBFC-' + btoa(JSON.stringify(p)).replace(/=+$/,'');
+}
+function parseFriendCode(code){
+  try{
+    const s = String(code || '').trim();
+    const m = s.match(/^BBFC-([A-Za-z0-9+\/=\-_]{8,})$/);
+    if (!m) return null;
+    const p = JSON.parse(atob(m[1]));
+    if (!p || p.v !== 1 || typeof p.str !== 'number') return null;
+    return { name:String(p.n || 'FRIEND').slice(0,16), str:Math.max(20, Math.min(99, p.str|0)), w:p.w|0, l:p.l|0 };
+  }catch(e){ return null; }
+}
