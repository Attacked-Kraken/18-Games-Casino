diff --git a/apexbaseball.html b/apexbaseball.html
--- a/apexbaseball.html
+++ b/apexbaseball.html
@@ -2197,6 +2197,39 @@
   get strikes(){ return G.strikes; },
   get crowdCount(){ return _park.loaded ? _park.fans : _crowd.seats.length; },
   get stadium(){ return { loaded: _park.loaded, aniso: _park.aniso || 0, fans: _park.fans, kitField: _park.kitField, kitFieldLive: !!(_park.kitTex && _park.fieldMesh && _park.fieldMesh.material && !Array.isArray(_park.fieldMesh.material) && _park.fieldMesh.material.map === _park.kitTex), night: _park.night }; },
+  // G-394: every rigged player's lowest posed sole vertex (world Y) vs the ground under its group (0, or 0.3 on the mound) — the robot's posed-sole method, full vertices, no stride. The play-feet-on-ground test reads this standing.
+  get soles(){
+    const seen = new Set(), out = [];
+    const figs = [];
+    const push = (f, name) => { if (f && f.athlete && f.bones && !seen.has(f)) { seen.add(f); figs.push([f, name]); } };
+    push(batterMesh, 'batter');
+    push(pitcherMesh, 'pitcher');
+    push(catcherMesh, 'catcher');
+    push(umpireMesh, 'umpire');
+    (lineup || []).forEach((f, i) => push(f, 'lineup' + (i + 1)));
+    (runnerMeshes || []).forEach((f, i) => push(f, 'runner' + (i + 1)));
+    Object.entries(fielders || {}).forEach(([k, f]) => push(f, 'fielder-' + k));
+    const v = new THREE.Vector3();
+    for (const [f, name] of figs) {
+      let low = Infinity;
+      for (const bn of ['foot_l', 'foot_r']) {
+        const c = f.bones[bn]; if (!c) continue;
+        const ids = new Set(); c.traverse(n => { if (n.isBone) ids.add(n.uuid); });
+        f.g.traverse(m => {
+          if (!m.isSkinnedMesh || !m.skeleton || !m.geometry || !m.geometry.attributes.skinIndex) return;
+          const bi = m.skeleton.bones.map((b, i) => ids.has(b.uuid) ? i : -1).filter(i => i >= 0);
+          if (!bi.length) return;
+          const si = m.geometry.attributes.skinIndex, sw = m.geometry.attributes.skinWeight;
+          m.updateMatrixWorld(true); if (m.skeleton.update) m.skeleton.update();
+          for (let vi = 0; vi < si.count; vi++) { let w = 0; for (let k = 0; k < 4; k++) if (bi.includes(si.getComponent(vi, k))) w += sw.getComponent(vi, k); if (w > 0.5) { m.getVertexPosition(vi, v); m.localToWorld(v); if (v.y < low) low = v.y; } }
+        });
+      }
+      if (!isFinite(low)) continue;
+      const gy = Math.hypot(f.g.position.x, f.g.position.z + 20.17) < 3 ? 0.3 : 0;
+      out.push({ name, sole: +low.toFixed(3), ground: gy, diffM: +((low - gy) * 0.9144).toFixed(3) });
+    }
+    return out;
+  },
   get kitAudio(){ return { crack: !!Mus.kit.crack, glove: !!Mus.kit.glove, cheer: !!Mus.kit.cheer, amb: !!Mus.kit.amb }; },
   get ball(){ return { x:+ball.position.x.toFixed(1), y:+ball.position.y.toFixed(1), z:+ball.position.z.toFixed(1), visible: ball.visible }; },
   get flightT(){ return G.phase === 'flight' ? flight.T : null; },   // G-262: the thrown pitch's own game time (fast 0.95 / curve 1.18 / change 1.38) so the timing test judges each flight against its own T, never a hardcoded fastball
