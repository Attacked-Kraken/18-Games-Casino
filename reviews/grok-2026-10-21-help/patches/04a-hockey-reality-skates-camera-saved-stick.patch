+const _bv=new THREE.Vector3();
+function bladeIdx(steel){ // every 3rd steel (blade) vertex, split left/right skate (posed feet tilt, so the lowest point moves along the blade)
+  const P=steel.geometry.attributes.position, L=[], R=[];
+  for(let i=0;i<P.count;i+=3) (P.getX(i)>=0?L:R).push(i);
+  return [L,R]; }
+function snapSkatesToIce(){
